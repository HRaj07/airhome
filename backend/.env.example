# Backend configuration. Every value below has a working development default,
# so this file is only needed when deploying. Copy to .env and edit, or set
# these as environment variables in your host's dashboard.

# Comma-separated list of origins allowed to call the API. Must be an exact
# match for the deployed frontend, with no trailing slash.
# Default: http://localhost:3000
CORS_ORIGINS=https://your-frontend.vercel.app

# SQLAlchemy connection string. Defaults to the bundled SQLite file
# (backend/airbnb.db), which ships pre-seeded with the demo data.
# DATABASE_URL=sqlite:///./airbnb.db

# Secret used to sign JWTs. The development default is public and committed —
# set a real random value in production, e.g. `openssl rand -hex 32`.
JWT_SECRET=replace-with-a-long-random-string
